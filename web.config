<?xml version="1.0" encoding="utf-8"?>
<!-- the root web configuration file -->
<configuration>
  <system.web>
    <compilation tempDirectory="D:\Inetpub\vhosts\ornek-kvkk.com\tmp" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Hassas klasörler: web'den erişim kapalı -->
        <rule name="Hassas Klasorleri Engelle" stopProcessing="true">
          <match url="(^|/)(config|temp|logs|\.git|\.public|\.history|\.lh|\.vscode|\.claude)(/|$)" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Erisim engellendi" />
        </rule>

        <!-- Genel form: /form/<uniqid> ve /form/<uniqid>/<metin> (aydinlatma, acik-riza, etk, gps) -->
        <rule name="Genel Form Metin" stopProcessing="true">
          <match url="^form/([A-Za-z0-9]{1,32})/(aydinlatma|acik-riza|etk|gps)/?$" />
          <action type="Rewrite" url="form.php?u={R:1}&amp;metin={R:2}" appendQueryString="false" />
        </rule>
        <rule name="Genel Form" stopProcessing="true">
          <match url="^form/([A-Za-z0-9]{1,32})/?$" />
          <action type="Rewrite" url="form.php?u={R:1}" appendQueryString="false" />
        </rule>

        <!-- SEO Dostu URL'ler - Admin Panel -->
        <rule name="Admin SEO URLs" stopProcessing="true">
          <match url="^admin/([a-z0-9-]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="admin/pages/{R:1}.php" />
        </rule>

        <!-- SEO Dostu URL'ler - Ön Yüz -->
        <rule name="Site SEO URLs" stopProcessing="true">
          <match url="^([a-z0-9-]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.php" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>